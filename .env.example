# Copy to `.env` and edit. `.env` is gitignored.
# All values are optional when using `just backend` (dev defaults apply); set
# them here to override. Variables already exported in your shell win.

# Bearer token every non-/health API route requires.
DEARBORN_TOKEN=dev-token

# AES-256-GCM key material used to encrypt PATs at rest.
DEARBORN_MASTER_KEY=dev-master-key

# Bind address for the HTTP server.
DEARBORN_BIND=127.0.0.1:8787

# Local libSQL/SQLite database file.
# DEARBORN_DB=./dearborn.db

# Per-project clone root.
# DEARBORN_CLONE_ROOT=./clones

# Built SPA assets served at / (absent => API only).
# DEARBORN_STATIC_DIR=./client/dist

# Executor tuning (Milestone 2 §2.7). Invalid/unparseable values fall back to
# the default below with a logged warning; they never fail boot.

# Number of executor worker loops.
# DEARBORN_WORKER_CONCURRENCY=2

# Executor lease lifetime, in seconds.
# DEARBORN_LEASE_TTL_SECS=300

# Executor lease renewal interval, in seconds.
# DEARBORN_HEARTBEAT_SECS=30

# Wall-clock ceiling per agent stage, in seconds.
# DEARBORN_AGENT_STAGE_TIMEOUT_SECS=1800

# Wall-clock ceiling per setup_cmd/test_cmd run, in seconds.
# DEARBORN_CMD_TIMEOUT_SECS=900

# Max attempts of the test-driven fix loop (ralph parity).
# DEARBORN_MAX_TEST_FIX_ATTEMPTS=3

# Max rounds of the review-convergence fix loop (ralph parity).
# DEARBORN_MAX_FIX_ROUNDS=3

# Extra re-runs when a review reply lacks a parseable verdict (ralph parity).
# DEARBORN_VERDICT_RETRIES=1

# Fallback poll interval for workers, behind the notify, in milliseconds.
# DEARBORN_POLL_INTERVAL_MS=1500
